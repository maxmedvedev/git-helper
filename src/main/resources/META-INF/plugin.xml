<idea-plugin>
    <id>max.medvedev.git-helper</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Advanced Git Features</name>

    <vendor>Max Medvedev</vendor>

    <description><![CDATA[
        Adds several useful actions to Git IntelliJ support which are not available in the main Git plugin.
        <ul>
            <li>Create a branch from master</li>
            <li>Delete the current branch and switch to another branch</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.GitHelperBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

    </extensions>

    <actions resource-bundle="messages.GitHelperBundle">
        <action id="Git.CreateBranchFromMaster"
                class="com.max.medvedev.githelper.newBranch.GitCreateBranchFromMasterAction"/>
        <action id="Git.DeleteCurrentBranchAndSwitch.External"
                class="com.max.medvedev.githelper.checkoutAndDelete.GitDeleteCurrentBranchAndSwitchAction">
            <add-to-group group-id="Git.Branch" anchor="last"/>
        </action>

    </actions>

</idea-plugin>